set -U fish_pager_color_completion   {{colors.on_surface.default.hex_stripped}}
set -U fish_pager_color_description  {{colors.on_surface_variant.default.hex_stripped}}
set -U fish_pager_color_progress     {{colors.on_vivid_value.default.hex_stripped}} --background={{colors.vivid_value.default.hex_stripped}}
set -U fish_pager_color_selected_background --background={{colors.primary_container.default.hex_stripped}}
